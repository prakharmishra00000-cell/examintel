# ============================================================
# ExamIntel — Environment Variables for Vercel
# ============================================================
# Set these in your Vercel project (Settings → Environment Variables).
# ============================================================

# REQUIRED: Gemini API key (recommended)
# With this set, ALL AI features use real Google Gemini AI — no mock data.
# Users visiting your live URL get real AI responses (no setup needed on their end).
#
# Get it from: https://aistudio.google.com/apikey → Create API key
# Default model: gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here

# ALTERNATIVE: OpenAI API key (if you prefer OpenAI instead of Gemini)
# Get it from: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini
# OPENAI_API_KEY=sk-proj-your-key-here

# OPTIONAL: Override the model name
# For Gemini: gemini-2.0-flash (default), gemini-1.5-pro, gemini-1.5-flash
# For OpenAI: gpt-4o-mini (default), gpt-4o
# OPENAI_MODEL=gemini-2.0-flash

# OPTIONAL: Override the base URL (for OpenRouter/Groq/Together etc.)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
