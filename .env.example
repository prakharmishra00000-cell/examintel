# ============================================================
# ExamIntel — Environment Variables for Vercel
# ============================================================
# Set these in your Vercel project (Settings → Environment Variables).
# ============================================================

# REQUIRED: OpenAI API key (or any OpenAI-compatible provider).
# Without this, the app runs in Demo Mode (mock data — UI is explorable, AI is canned).
# With this set, ALL AI features use real AI (no mock data).
#
# Get it from: https://platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=sk-proj-your-key-here

# OPTIONAL: Base URL for OpenAI-compatible providers.
# Use this to plug in OpenRouter, Groq, Together, Azure, etc.
# Examples:
#   https://openrouter.ai/api/v1   (OpenRouter — access many models)
#   https://api.groq.com/openai/v1   (Groq — fast + free tier)
#   https://api.together.xyz/v1     (Together)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=

# OPTIONAL: Model name. Defaults to gpt-4o-mini.
# Other options:
#   gpt-4o-mini        (OpenAI — cheap + capable, recommended)
#   gpt-4o             (OpenAI — higher quality, pricier)
#   llama-3.3-70b-versatile  (via Groq — free tier available)
#   anthropic/claude-3.5-sonnet  (via OpenRouter)
# OPENAI_MODEL=gpt-4o-mini
